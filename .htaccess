AddDefaultCharset utf-8
Options -Indexes

RewriteEngine On
RewriteBase /

# Уже обработанные адреса не трогаем (иначе правила будут зацикливаться)
RewriteRule ^index\.php$ - [L]
RewriteRule ^web/ - [L]

# Служебные папки и файлы закрыты от прямого доступа
RewriteRule ^(\.git|\.osp|config|models|controllers|components|database|frontend|docs)(/|$) - [F,L]
RewriteRule \.sql$ - [F,L]

# /api/... обрабатывает PHP
RewriteRule ^api(/|$) index.php [L]

# Готовые файлы React-приложения (скрипты, стили, картинки)
RewriteCond %{DOCUMENT_ROOT}/web%{REQUEST_URI} -f
RewriteRule ^(.*)$ web/$1 [L]

# Все остальные адреса открывает React (его собственные маршруты)
RewriteRule ^ web/index.html [L]
